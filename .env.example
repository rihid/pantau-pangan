# Template environment variable Pantau Pangan
# Copy file ini ke .env (atau .env.local) dan isi nilai aslinya. Jangan commit .env.

# Connection string PostgreSQL (untuk apps/api lewat Drizzle)
DATABASE_URL=postgresql://user:password@localhost:5432/pantau_pangan

# API key OpenRouter — provider LLM V1 untuk insight komoditas
OPENROUTER_API_KEY=sk-or-your-key-here

# Port HTTP server apps/api (Hono + Bun)
API_PORT=3001

# URL public apps/api yang dipakai apps/web (Next.js) untuk fetch data
NEXT_PUBLIC_API_URL=http://localhost:3001
