# Template environment variable Pantau Pangan
# Copy file ini ke .env (atau .env.local) dan isi nilai aslinya. Jangan commit .env.

# Connection string PostgreSQL (untuk apps/api lewat Drizzle)
DATABASE_URL=postgresql://user:password@localhost:5432/pantau_pangan

# API key LLM — General Compute (provider utama, OpenAI-compatible: https://api.generalcompute.com/v1)
GENERALCOMPUTE_API_KEY=gc_your-key-here
GENERALCOMPUTE_MODEL=minimax-m2.7

# API key OpenRouter — fallback LLM (opsional)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Port HTTP server apps/api (Hono + Bun)
API_PORT=3001

# URL public apps/api yang dipakai apps/web (Next.js) untuk fetch data
NEXT_PUBLIC_API_URL=http://localhost:3001
