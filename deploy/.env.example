# ============================================================
# Pantau Pangan — environment produksi (deploy/.env)
# Copy ke deploy/.env lalu isi. JANGAN commit deploy/.env.
#   cp deploy/.env.example deploy/.env
# ============================================================

# ---------- Database (Postgres container) ----------
# Password HARUS alfanumerik (tanpa karakter khusus) — dipakai langsung
# di dalam connection string DATABASE_URL.
POSTGRES_USER=pantau
POSTGRES_PASSWORD=ganti-password-kuat-alfanumerik
POSTGRES_DB=pantau_pangan

# ---------- LLM — General Compute (provider utama) ----------
GENERALCOMPUTE_API_KEY=gc_your-key-here
GENERALCOMPUTE_MODEL=minimax-m2.7

# ---------- LLM — OpenRouter (fallback) ----------
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---------- URL publik API (dilihat browser) ----------
# Di-inline saat build image web (NEXT_PUBLIC_*), jadi perubahan di sini
# mengharuskan rebuild: docker compose up -d --build web
#
# Tanpa domain (akses via IP): http://VPS_IP/api
# Dengan domain:                https://pantaupangan.id/api
NEXT_PUBLIC_API_URL=http://VPS_IP/api

# ---------- Nginx port binding ----------
# Default 80/443. Ubah hanya untuk testing lokal (mis. 8080/8443).
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---------- Domain (dipakai untuk SSL via certbot) ----------
# Kosongkan jika belum punya domain.
DOMAIN=pantaupangan.id