# Pantau Pangan — nginx dengan SSL (Let's Encrypt).
#
# CARA AKTIFKAN:
#   1. Buat sertifikat dulu (lihat deploy/README.md → SSL):
#      docker compose run --rm certbot certonly --webroot ...
#   2. Ganti DOMAIN di bawah dengan domain asli.
#   3. Di folder deploy/nginx/conf.d:
#        mv default.conf default.conf.http-backup
#        mv ssl.conf.example ssl.conf
#   4. Reload: docker compose exec nginx nginx -s reload

# HTTP → HTTPS redirect (kecuali ACME challenge untuk renewal)
server {
    listen 80;
    server_name DOMAIN www.DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    server_name DOMAIN www.DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 10m;

    # API — prefix /api/ di-strip
    location /api/ {
        proxy_pass http://api:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Web
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}